  lineas:
  - imagen: {fileID: 21300000, guid: 2eca0d6d0896dfe46b4e7659a809033f, type: 3}
    texto: Mateo vuelve a encender el televisor.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 2eca0d6d0896dfe46b4e7659a809033f, type: 3}
    texto: "REPORTERA: \u201CLas lluvias llegar\xE1n esta noche. Especialistas advierten
      que varios desag\xFCes de la ciudad permanecen obstruidos.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 2eca0d6d0896dfe46b4e7659a809033f, type: 3}
    texto: "Mateo mira la pantalla con preocupaci\xF3n, recordando la basura acumulada
      en las calles y el parque."
    decision: {fileID: 0}
