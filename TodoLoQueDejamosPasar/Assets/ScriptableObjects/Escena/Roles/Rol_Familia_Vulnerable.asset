  m_Script: {fileID: 11500000, guid: 119fb526298f68f40ab5b1ad2408ff68, type: 3}
  m_Name: Rol_Familia_Vulnerable
  m_EditorClassIdentifier: Assembly-CSharp::EscenaRolData
  lineas:
  - imagen: {fileID: 21300000, guid: f3e20ea3a27ab4b4fbd3ddee0ae189e5, type: 3}
    texto: Mateo vuelve a encender el televisor mientras la lluvia cae sobre el barrio.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: f3e20ea3a27ab4b4fbd3ddee0ae189e5, type: 3}
    texto: "REPORTERA: \u201CLas lluvias contin\xFAan afectando varios sectores del
      barrio. Vecinos reportan aniegos y da\xF1os en viviendas cercanas a la calle
      principal.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: db24b62392fe03240a8a1aff00b6186c, type: 3}
    texto: "Luego aparece una reportera frente a una casa parcialmente inundada.
      Detr\xE1s de ella, una familia saca cajas mojadas y algunos muebles da\xF1ados."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: db24b62392fe03240a8a1aff00b6186c, type: 3}
    texto: "REPORTERA: \u201CLas lluvias afectaron varias viviendas del barrio durante
      la madrugada.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: db24b62392fe03240a8a1aff00b6186c, type: 3}
    texto: "La c\xE1mara enfoca a una ni\xF1a abrazando una mochila mojada."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: db24b62392fe03240a8a1aff00b6186c, type: 3}
    texto: Mateo observa la pantalla en silencio.
    decision: {fileID: 0}
