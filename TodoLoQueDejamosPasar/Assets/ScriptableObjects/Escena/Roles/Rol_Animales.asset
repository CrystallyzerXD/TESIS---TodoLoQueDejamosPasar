--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 119fb526298f68f40ab5b1ad2408ff68, type: 3}
  m_Name: Rol_Animales
  m_EditorClassIdentifier: Assembly-CSharp::EscenaRolData
  lineas:
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: Mateo regresa de noche y, al acercarse al edificio, ve a Nube echado junto
      a una bolsa de basura rota en la vereda.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: "MATEO: \u201C\xBFNube?\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: "Se acerca r\xE1pidamente. Cerca hay restos de comida mezclados con residuos
      de limpieza derramados."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: "MATEO: \u201C\xA1Nube!\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: Lo carga entre sus brazos.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: "VECINO: \u201CDebe haber comido algo de la basura... Antes esto no pasaba.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: Nube respira con dificultad por unos segundos.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: "MATEO: \u201CNo, por favor... m\xEDrame..."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 605ff758cc88afc42bad4f1f3d86a995, type: 3}
    texto: "Mateo se queda en silencio, abraz\xE1ndolo y lo lleva al veterinario."
    decision: {fileID: 0}
