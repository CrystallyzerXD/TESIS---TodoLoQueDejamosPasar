%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 119fb526298f68f40ab5b1ad2408ff68, type: 3}
  m_Name: Rol_NinoYPadre
  m_EditorClassIdentifier: Assembly-CSharp::EscenaRolData
  lineas:
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: "El ni\xF1o se acerca lentamente a los juegos del parque y mira el columpio
      en silencio. El suelo est\xE1 cubierto de bolsas, botellas y papeles mojados.
      Cerca de los juegos hay un charco oscuro junto a un tacho desbordado."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: "PADRE: \u201CNo, hijo. No puedes jugar ac\xE1.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: "NI\xD1O: \u201C\xBFPor qu\xE9?\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: El padre observa alrededor por unos segundos antes de responder.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: "PADRE: \u201CPorque est\xE1 muy sucio. Podr\xEDas enfermarte.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: "El ni\xF1o baja la mirada y se queda quieto, sujetando la mano de su
      padre."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: "PADRE: \u201CAntes esto no era as\xED. Cuando yo era peque\xF1o, este
      parque siempre estaba lleno. Hab\xEDa ni\xF1os jugando, \xE1rboles, flores\u2026
      Ahora ya nadie quiere venir.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 8bf51187ab52f7e43a541f1734479a5d, type: 3}
    texto: Mateo observa la escena desde unos metros de distancia, en silencio.
    decision: {fileID: 11400000, guid: ce768f309391df344b06ed9a59a194c5, type: 2}
