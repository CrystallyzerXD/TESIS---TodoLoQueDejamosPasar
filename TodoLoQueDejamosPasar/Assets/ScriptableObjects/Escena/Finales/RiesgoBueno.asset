%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 119fb526298f68f40ab5b1ad2408ff68, type: 3}
  m_Name: RiesgoBueno
  m_EditorClassIdentifier: Assembly-CSharp::EscenaRolData
  lineas:
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: 
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: "La lluvia pas\xF3 sin llevarse nada consigo."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: "Los desag\xFCes aguantaron. Las calles tambi\xE9n."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: "Mateo recuerda al ni\xF1o de ayer.\n\"Pap\xE1, \xBFahora s\xED puedo
      jugar?\""
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: "Una semana atr\xE1s, la respuesta hubiera sido no."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: El barrio no lo hubiera permitido.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: Mateo mira el parque.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: "Algo cambi\xF3 esta semana."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: df17dde0e1540d64f989011228466993, type: 3}
    texto: "Algo peque\xF1o. Algo suficiente."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: 206c362dfbc38244daf7b557089738c5, type: 3}
    texto: "\u201CNo pude arreglar todo. La lluvia lleg\xF3 igual. Pero mientras
      ve\xEDa a ese ni\xF1o acercarse otra vez al parque, entend\xED que los cambios
      peque\xF1os s\xED importan. Tal vez la ciudad no cambia de un d\xEDa para otro.
      Pero cambia cuando alguien decide empezar.\u201D"
    decision: {fileID: 0}
