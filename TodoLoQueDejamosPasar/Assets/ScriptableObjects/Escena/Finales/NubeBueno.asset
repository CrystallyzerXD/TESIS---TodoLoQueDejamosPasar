--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 119fb526298f68f40ab5b1ad2408ff68, type: 3}
  m_Name: NubeBueno
  m_EditorClassIdentifier: Assembly-CSharp::EscenaRolData
  lineas:
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: "El tel\xE9fono de Mateo suena mientras est\xE1 a punto de llegar a casa."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: "VETERINARIO: \u201C\xBFMateo? Te llamo por Nube.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: Mateo guarda silencio unos segundos.
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: "VETERINARIO: \u201CLogramos estabilizarlo. Fue una intoxicaci\xF3n fuerte,
      pero lleg\xF3 a tiempo. Va a necesitar quedarse unos d\xEDas m\xE1s, pero creemos
      que se va a recuperar.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: "Mateo cierra los ojos y sonr\xEDe apenas."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: "VETERINARIO: \u201CTuvo suerte.\u201D"
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: "Mateo mira el barrio una vez m\xE1s."
    decision: {fileID: 0}
  - imagen: {fileID: 21300000, guid: d6d63716860ab8a4dbdad8324276223f, type: 3}
    texto: "Por primera vez en varios d\xEDas, siente que quiz\xE1 todav\xEDa no
      todo est\xE1 perdido."
    decision: {fileID: 0}
