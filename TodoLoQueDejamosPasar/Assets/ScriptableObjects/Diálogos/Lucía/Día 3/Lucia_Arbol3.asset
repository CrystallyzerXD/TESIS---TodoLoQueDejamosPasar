  m_Script: {fileID: 11500000, guid: c860f5a4c7bb1974d938e3791b9a4290, type: 3}
  m_Name: Lucia_Arbol3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lineas:
  - nombrePersonaje: Mateo
    texto: "Quiz\xE1 Javier tiene raz\xF3n. Si el barrio necesita espacio, tal vez
      sea necesario."
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: "Luc\xEDa"
    texto: "\xBFNecesario para qui\xE9n?"
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: Mateo
    texto: "Solo digo que quiz\xE1 ya tomaron esa decisi\xF3n por algo."
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: "Luc\xEDa"
    texto: Ese es el problema, Mateo. Siempre dejamos que otros decidan por nosotros.
    anclaPersonaje: {fileID: 0}
