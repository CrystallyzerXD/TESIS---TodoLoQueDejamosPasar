  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c860f5a4c7bb1974d938e3791b9a4290, type: 3}
  m_Name: Lucia_Dia3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lineas:
  - nombrePersonaje: "Luc\xEDa"
    texto: "Mateo, ven un momento\u2026 mira esto."
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: Mateo
    texto: "\xBFQu\xE9 pas\xF3?"
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: "Luc\xEDa"
    texto: Han puesto este aviso en el parque.
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: "Luc\xEDa"
    texto: "Dice que van a ampliar el estacionamiento y que van a retirar los \xE1rboles
      de esta zona."
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: Mateo
    texto: "\xBFRetirar los \xE1rboles?"
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: Javier
    texto: "No suena tan mal. A veces no hay d\xF3nde estacionar por ac\xE1."
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: "Luc\xEDa"
    texto: "\xBFY por eso van a quitar los pocos \xE1rboles que quedan?"
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: Javier
    texto: "Tambi\xE9n es parte del barrio, Luc\xEDa. La gente necesita espacio."
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: "Luc\xEDa"
    texto: "Pero este parque tambi\xE9n es espacio para la gente."
    anclaPersonaje: {fileID: 0}
  - nombrePersonaje: "Luc\xEDa"
    texto: "Sin \xE1rboles va a hacer m\xE1s calor, habr\xE1 menos sombra y el parque
      se va a sentir peor."
    anclaPersonaje: {fileID: 0}
