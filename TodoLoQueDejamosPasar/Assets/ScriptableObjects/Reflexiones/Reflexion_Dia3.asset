  m_Script: {fileID: 11500000, guid: d5b7c2b0062451e468ab72a4ecae03c6, type: 3}
  m_Name: Reflexion_Dia3
  m_EditorClassIdentifier: Assembly-CSharp::ReflexionData
  reflexiones:
  - texto: "\u201CNunca hab\xEDa pensado que unos \xE1rboles pudieran importar tanto.
      No solo hacen ver bonito el parque. Son sombra, aire\u2026 y quiz\xE1 lo \xFAnico
      que evita que todo empeore.\u201D"
    diaRequerido: 3
    contaminacion:
      tipo: 0
      valor: 0
    bienestar:
      tipo: 0
      valor: 0
    riesgo:
      tipo: 0
      valor: 0
    arboles:
      tipo: 0
      valor: 5
    arbolesPendiente:
      tipo: 3
      valor: 1
  - texto: "\u201CNo dije nada porque sent\xED que no era asunto m\xEDo. Pero mientras
      volv\xEDa a casa, no pude evitar pensar que quiz\xE1 eso mismo piensa todo
      el mundo.\u201D"
    diaRequerido: 3
    contaminacion:
      tipo: 0
      valor: 0
    bienestar:
      tipo: 0
      valor: 0
    riesgo:
      tipo: 0
      valor: 0
    arboles:
      tipo: 0
      valor: 5
    arbolesPendiente:
      tipo: 3
      valor: 2
  - texto: "\u201CPor un momento me pareci\xF3 l\xF3gico. M\xE1s espacio, m\xE1s
      orden. Pero ahora que veo el parque vac\xEDo, siento que tal vez estamos arreglando
      una cosa mientras destruimos otra.\u201D"
    diaRequerido: 3
    contaminacion:
      tipo: 0
      valor: 0
    bienestar:
      tipo: 0
      valor: 0
    riesgo:
      tipo: 0
      valor: 0
    arboles:
      tipo: 0
      valor: 5
    arbolesPendiente:
      tipo: 3
      valor: 3
